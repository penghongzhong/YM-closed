import Mathlib

set_option autoImplicit false
noncomputable section

namespace YMUIC.I7RG

open scoped InnerProductSpace ComplexConjugate

/-!
# Exact coarse/fine inner-product decomposition

The statement is the Hilbert projection identity needed for the
ACTUAL finite-cutoff Wilson measure after an exact RG blocking:
the conditional expectation P onto the sigma-algebra generated by
coarse variables is a self-adjoint idempotent on L2(mu).

For X = reflection of a centered Wilson loop and Y = a translated
centered loop, the identity splits their full two-point function into
the coarse-conditional-means contribution plus the conditional
fine-field covariance.

No Yang--Mills bound, exponential correlation decay, OS transfer,
or numerical I7 inequality is derived. In particular a Bałaban old/new-R
polymer remainder is NOT identified with the fine-field term.
-/

/-- Every self-adjoint idempotent splits the true inner product
into an exact coarse term and a fine-fluctuation term.
No commutation of P with the transfer is required. -/
theorem exact_coarse_fine_inner
    {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (P : H →L[ℂ] H)
    (hIdem : ∀ y : H, P (P y) = P y)
    (hSym : ∀ x y : H, ⟪P x, y⟫_ℂ = ⟪x, P y⟫_ℂ)
    (x y : H) :
    ⟪x, y⟫_ℂ =
       ⟪P x, P y⟫_ℂ +
       ⟪x - P x, y - P y⟫_ℂ := by
  have hproj : ⟪P x, P y⟫_ℂ = ⟪x, P y⟫_ℂ := by
    calc
      ⟪P x, P y⟫_ℂ = ⟪x, P (P y)⟫_ℂ := hSym x (P y)
      _ = ⟪x, P y⟫_ℂ := by rw [hIdem y]
  have hcrossL : ⟪P x, y - P y⟫_ℂ = 0 := by
    rw [inner_sub_right, hSym x y, hproj]
    exact sub_self _
  have hcrossR : ⟪x - P x, P y⟫_ℂ = 0 := by
    rw [inner_sub_left, hproj]
    exact sub_self _
  calc
    ⟪x,y⟫_ℂ =
        ⟪P x + (x - P x), P y + (y - P y)⟫_ℂ := by
      congr 1 <;> abel
    _ = ⟪P x, P y⟫_ℂ + ⟪x - P x, y - P y⟫_ℂ := by
      rw [inner_add_left, inner_add_right, inner_add_right]
      rw [hcrossL, hcrossR]
      abel

#print axioms exact_coarse_fine_inner

end YMUIC.I7RG
